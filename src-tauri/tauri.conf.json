{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Koyt",
  "version": "0.1.0",
  "identifier": "net.kasasbeh.koyt",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src *; frame-src *; connect-src ipc: http://ipc.localhost *; media-src stream: http://stream.localhost asset: http://asset.localhost *; script-src * 'unsafe-inline'; style-src * 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
